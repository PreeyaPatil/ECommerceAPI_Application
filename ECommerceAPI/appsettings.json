{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "ECommerceDBConnection": "Server=.;Database=FS_ECommerceDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Pricing": {
    "TaxRate": 0.18,
    "FlatShippingCharge": 99,
    "FreeShippingThreshold": 2000
  },

  "Jwt": {
    "Issuer": "ECommerceAPI",
    "Audience": "ECommerceClient",
    "Key": "YOUR_SECRETE_KEY",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "TwoFactor": {
    "CodeExpiryMinutes": 5,
    "MaxFailedAttempts": 5
  },

  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "E-Commerce Application",
    "FromEmail": "patilpreeya1008@gmail.com",
    "Username": "patilpreeya1008@gmail.com",
    "AppPassword": "YOUR_GMAIL_APP_PASSWORD"
  },
  //"ECommerceAppPassword": null,
  "Twilio": {
    "AccountSid": "TWILIO_ACCOUNT_ID",
    "AuthToken": "TWILIO_ATUHTO_TOKEN",
    "FromPhoneNumber": "+TWILIO_NUMBER"
  },

  "Notifications": {
    "BatchSize": 20,
    "PollingSeconds": 5,
    "MaxRetries": 3,
    "ProcessingTimeoutMinutes": 5
  },

  "Verification": {
    "CodeExpiryMinutes": 10,
    "MaxFailedAttempts": 5
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ecommerce-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [TraceId: {TraceIdentifier}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
